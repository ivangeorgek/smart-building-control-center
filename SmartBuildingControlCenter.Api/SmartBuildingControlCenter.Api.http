@baseUrl = https://localhost:7042

### Get all buildings
GET {{baseUrl}}/api/buildings
Accept: application/json

### Update Room 102 occupancy
PUT {{baseUrl}}/api/rooms/102/occupancy
Content-Type: application/json

false

### Verify Room 102 occupancy
GET {{baseUrl}}/api/rooms/102
Accept: application/json

### Try updating a room that doesn't exist
PUT {{baseUrl}}/api/rooms/999/occupancy
Content-Type: application/json

true

### Get the occupied room count
GET {{baseUrl}}/api/rooms/occupied-count
Accept: application/json

### Set Room 101 to occupied
PUT {{baseUrl}}/api/rooms/101/occupancy
Content-Type: application/json

true

### Get updated occupied room count
GET {{baseUrl}}/api/rooms/occupied-count
Accept: application/json

### Get occupancy percentage
GET {{baseUrl}}/api/rooms/occupancy-percentage
Accept: application/json

### Set Room 101 to occupied
PUT {{baseUrl}}/api/rooms/101/occupancy
Content-Type: application/json

true

### Check occupancy percentage
GET {{baseUrl}}/api/rooms/occupancy-percentage
Accept: application/json

### Set Room 102 to unoccupied
PUT {{baseUrl}}/api/rooms/102/occupancy
Content-Type: application/json

false

### Check occupancy percentage again
GET {{baseUrl}}/api/rooms/occupancy-percentage
Accept: application/json

### Check building statistics
GET {{baseUrl}}/api/buildings/statistics
Accept: application/json

### Set Room 101 to occupied
PUT {{baseUrl}}/api/rooms/101/occupancy
Content-Type: application/json

true

### Get updated building statistics
GET {{baseUrl}}/api/buildings/statistics
Accept: application/json

### Get occupied room count for Floor 1
GET {{baseUrl}}/api/floors/1/occupied-count
Accept: application/json

### Get occupied room count for Floor 2
GET {{baseUrl}}/api/floors/2/occupied-count
Accept: application/json

### Get occupied room count for nonexistent Floor 999
GET {{baseUrl}}/api/floors/999/occupied-count
Accept: application/json
